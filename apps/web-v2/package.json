{
	"name": "web-v2",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"homepage": "https://rahul-rocket.github.io",
	"engines": {
		"node": ">=22.11.0 <23"
	},
	"scripts": {
		"dev": "next dev --port 3001",
		"build": "next build && node scripts/generate-og.mjs && node scripts/generate-feeds.mjs",
		"start": "serve out --no-clipboard --listen 3001",
		"start:test": "serve out --no-clipboard --listen 4319",
		"check-types": "tsc --noEmit",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest run",
		"content:validate": "vitest run content.validate",
		"test:watch": "vitest",
		"check:contrast": "node scripts/check-contrast.mjs",
		"check:export": "node scripts/check-export.mjs",
		"check:image-size": "node scripts/check-image-size.mjs",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"lh": "lhci autorun",
		"size": "size-limit",
		"check:links": "node scripts/check-links.mjs",
		"feeds": "node scripts/generate-feeds.mjs",
		"og:generate": "node scripts/generate-og.mjs"
	},
	"dependencies": {
		"@mdx-js/loader": "3.1.0",
		"@next/mdx": "15.1.6",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"gray-matter": "4.0.3",
		"lenis": "1.3.25",
		"next": "15.1.6",
		"react": "19.0.0",
		"react-dom": "19.0.0",
		"reading-time": "1.5.0",
		"rehype-autolink-headings": "7.1.0",
		"rehype-pretty-code": "0.14.0",
		"rehype-slug": "6.0.0",
		"remark-frontmatter": "5.0.0",
		"remark-gfm": "4.0.0",
		"shiki": "1.26.1",
		"tailwind-merge": "3.6.0",
		"zod": "3.24.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.10.1",
		"@biomejs/biome": "2.5.6",
		"@fontsource/inter": "5.1.1",
		"@lhci/cli": "0.14.0",
		"@playwright/test": "1.49.1",
		"@resvg/resvg-js": "2.6.2",
		"@size-limit/file": "11.1.6",
		"@tailwindcss/postcss": "4.3.3",
		"@types/mdx": "2.0.13",
		"@types/node": "22.10.7",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"axe-core": "4.10.2",
		"satori": "0.12.1",
		"serve": "14.2.4",
		"size-limit": "11.1.6",
		"tailwindcss": "4.3.3",
		"typescript": "5.7.3",
		"vitest": "2.1.8"
	}
}
