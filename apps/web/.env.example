# Copy to .env and fill in real values. .env is git-ignored.

# Neon Postgres connection string -- use the POOLED endpoint (host contains
# "-pooler"). Leave empty and /blog falls back to the seeded posts in
# lib/posts.ts, while /api/contact returns 500 and rate limiting is skipped.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Salt for the IP hash used by rate limiting and stored on contact submissions.
# Unsalted IP hashes are reversible by brute force -- the IPv4 space is small
# enough to enumerate. Set a long random value in production.
# Changing it resets every open rate-limit window.
IP_HASH_SALT=

# Public origin of the deployed site. Feeds canonical URLs, Open Graph images,
# sitemap.xml, and robots.txt -- a wrong value here misdirects crawlers.
# Falls back to https://rahul.dev when unset.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
