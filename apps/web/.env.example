# Copy to .env and fill in real values. .env is git-ignored.

# Neon Postgres connection string -- use the POOLED endpoint (host contains
# "-pooler"). Leave empty and /blog falls back to the seeded posts in
# lib/posts.ts, so the build works with no Neon project attached.
#
# THIS IS NOW A BUILD-TIME READ ONLY. This app is a static export
# (next.config.js, `output: 'export'`), so /blog is rendered once during
# `next build` and the result is baked into out/. Inserting a row afterwards does
# not change the live site until the deploy workflow runs again -- publishing a
# post is a deploy, not a database write.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Third-party endpoint the contact form POSTs to (Formspree-shaped: 2xx on
# success, 429 when rate limited, 422 with a per-field error list).
#
# Leave it empty and the form becomes a composer: submitting opens the reader's
# own mail client with the message prefilled, and the button says so rather than
# claiming to send. Both modes are real; which one is live is decided at build
# time by whether this is set.
#
# NEXT_PUBLIC_ is required because the value is read in the browser. That is not
# a leak -- a form endpoint is a URL anyone can read out of the HTML.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Public origin of the deployed site. Feeds canonical URLs, Open Graph images,
# sitemap.xml, and robots.txt -- a wrong value here misdirects crawlers.
# Falls back to https://rahul-rocket.github.io when unset, which is what the
# deploy workflow also sets it to.
#
# Do NOT add a /v2 suffix here. This app owns the apex; apps/web-v2 is the one
# published under /v2 and it carries its own URL in src/config/site.ts.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# REMOVED with the move to a static export:
#
#   IP_HASH_SALT -- salted the IP hash used by the rate limiter on
#                   /api/contact. Both the endpoint and lib/rate-limit.ts are
#                   gone, because GitHub Pages cannot accept a POST. Rate
#                   limiting is now the form service's job.
#
# If this app ever moves back behind a server, that variable returns in the same
# commit that removes `output: 'export'`.
